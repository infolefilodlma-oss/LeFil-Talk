# Le Fil Talk - Matrix Push Gateway (Sygnal)
# Confidential: never put the actual Firebase service-account JSON in GitHub.
http:
  bind_addresses: ['0.0.0.0']
  port: 5000
apps:
  net.lefil.talk.debug:
    type: gcm
    api_version: v1
    project_id: le-fil-talk
    service_account_file: /sygnal/firebase-service-account.json
    send_badge_counts: false
